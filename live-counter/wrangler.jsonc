{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "live-counter",
	"main": "src/index.js",
	"compatibility_date": "2026-08-20",
	"migrations": [
		{
			"new_sqlite_classes": [
				"LiveCounter"
			],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "LiveCounter",
				"name": "LIVE_COUNTER"
			}
		]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}