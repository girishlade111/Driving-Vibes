# Backblaze B2 S3-Compatible Storage Configuration
# Note: DO NOT prefix with VITE_ to keep credentials securely on the server side.

# Backblaze S3 Endpoint (e.g. s3.us-west-004.backblazeb2.com)
B2_ENDPOINT=s3.us-west-004.backblazeb2.com

# Backblaze Region (e.g. us-west-004)
B2_REGION=us-west-004

# Bucket Name
B2_BUCKET_NAME=your-music-bucket-name

# Application Key ID (KeyID from B2 Application Keys)
B2_APPLICATION_KEY_ID=your-key-id

# Application Key (ApplicationKey from B2 Application Keys)
B2_APPLICATION_KEY=your-application-key

# Set to true if bucket is Private (uses presigned streaming URLs) or false for Public bucket
B2_IS_PRIVATE=true

# Server Port
PORT=3001
