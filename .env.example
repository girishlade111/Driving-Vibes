# ─────────────────────────────────────────────────────────────────────────
# Driving Vibes — Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control (it is gitignored).
# ─────────────────────────────────────────────────────────────────────────

# ── Cloudflare R2 Storage ─────────────────────────────────────────────────
# Credentials are ONLY read on the server (Node/Express).
# They are NEVER sent to or accessible by the browser.

# Your Cloudflare Account ID
# Find it at: Cloudflare Dashboard → Right sidebar under "Account ID"
R2_ACCOUNT_ID=your-cloudflare-account-id

# R2 API Token — Access Key ID
# Create at: Cloudflare Dashboard → R2 → Manage R2 API Tokens → Create API Token
# Permission required: Object Read (or Object Read & Write)
R2_ACCESS_KEY_ID=your-r2-access-key-id

# R2 API Token — Secret Access Key (shown once when you create the token)
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# The name of your R2 music bucket
R2_BUCKET_NAME=your-music-bucket-name

# Set to true if your bucket is Private (server will generate presigned URLs, 2h expiry).
# Set to false if your bucket has a Public URL / custom domain enabled.
# Private is recommended for production.
R2_IS_PRIVATE=true

# Public bucket URL — only needed when R2_IS_PRIVATE=false.
# Use your custom domain (recommended) or the r2.dev public URL.
# Example (r2.dev):     https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# Example (custom):     https://music.yourdomain.com
R2_PUBLIC_URL=

# ── Server ────────────────────────────────────────────────────────────────

# Port for the Express backend server
PORT=3001

# ── CORS (Production only) ────────────────────────────────────────────────
# In development, localhost is allowed automatically.
# In production, set this to your actual frontend domain to restrict CORS.
# Example: https://drivingvibes.example.com
FRONTEND_ORIGIN=
