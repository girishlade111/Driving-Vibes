# ─────────────────────────────────────────────────────────────────────────
# Driving Vibes — Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control (it is gitignored).
# ─────────────────────────────────────────────────────────────────────────

# ── Backblaze B2 S3-Compatible Storage ────────────────────────────────────
# Credentials are ONLY read on the server (Node/Express).
# They are NEVER sent to or accessible by the browser.

# S3-compatible endpoint for your Backblaze region
# Example: s3.us-west-004.backblazeb2.com
B2_ENDPOINT=s3.us-west-004.backblazeb2.com

# Backblaze region (shown on your bucket settings page)
# Example: us-west-004
B2_REGION=us-west-004

# The name of your music bucket
B2_BUCKET_NAME=your-music-bucket-name

# Application Key ID (from Backblaze → App Keys → Add New Application Key)
B2_APPLICATION_KEY_ID=your-key-id-here

# Application Key (the secret shown once when you create the key)
B2_APPLICATION_KEY=your-secret-application-key-here

# Set to true if your bucket is Private (server will generate presigned URLs).
# Set to false if your bucket is Public (server will return direct public URLs).
# Private is recommended for production — presigned URLs expire after 2 hours.
B2_IS_PRIVATE=true

# ── Server ────────────────────────────────────────────────────────────────

# Port for the Express backend server
PORT=3001

# ── CORS (Production only) ────────────────────────────────────────────────
# In development, localhost is allowed automatically.
# In production, set this to your actual frontend domain to restrict CORS.
# Example: https://drivingvibes.example.com
FRONTEND_ORIGIN=
